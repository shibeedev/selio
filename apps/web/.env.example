# Copy to .env.local to override the defaults. Every value is optional.
#
# JSON-RPC endpoint per network (default: the SDK's defaultRpcUrl).
# VITE_RPC_MONAD_TESTNET=http://127.0.0.1:8603
# VITE_RPC_USDT0_REPLAY=http://127.0.0.1:8602
# VITE_RPC_VAULT_FREEZE=http://127.0.0.1:8604
#
# Selio backend for history, alerts and demo funds. Default: http://127.0.0.1:8787
# under `vite dev`, https://api.selio.site in a production build.
# VITE_API_URL=http://127.0.0.1:8787
#
# Dynamic environment for the email or passkey wallet (Monad Testnet only). Unset: the wallet menu and
# the exit agent panel say it is not configured on this deployment.
# VITE_DYNAMIC_ENVIRONMENT_ID=
#
# Exit agent service; its alert webhooks go to <VITE_AGENT_URL>/hooks/alert/<grantId>. Unset: the exit
# agent panel says it is not configured. Hosted build: https://agent.selio.site
# VITE_AGENT_URL=
#
# Build only: let Monad Testnet use contracts/deployments/local/monad-testnet.json.
# SELIO_LOCAL_TESTNETS=1
