# Selio exit agent (apps/agent). Empty values mean unset. Never commit real values.

# Listen port; the address is always 127.0.0.1. Integer, default 8788.
PORT=
# SQLite database file. Path, default apps/agent/data/agent.db (on the VM /var/lib/selio/agent.db).
DB_PATH=
# pino level: fatal, error, warn, info, debug, trace or silent. Default info.
LOG_LEVEL=
# Name bound to every log line. Default: the host name.
NODE_ID=
# Required. Web app origin(s) allowed by CORS, comma-separated, e.g. https://selio.site or http://localhost:5173.
CORS_ORIGIN=
# Folder holding monad-testnet.json (the only file read). Path, default <repo>/contracts/deployments.
DEPLOYMENTS_DIR=
# Monad testnet JSON-RPC. URL, default https://testnet-rpc.monad.xyz.
RPC_MONAD_TESTNET=
# Hosted MCP endpoint over loopback. URL, default http://127.0.0.1:8787/mcp.
MCP_URL=
# Required. Equals the backend's WEBHOOK_SECRET (alert webhooks carry its X-Selio-Signature).
SELIO_WEBHOOK_SECRET=

# Dynamic credentials: set all three, or none (the agent then starts in the "not configured" state).
# Environment ID from the Dynamic dashboard. UUID.
DYNAMIC_ENVIRONMENT_ID=
# Server API token (dyn_...) for delegated signing, the admin revoke call and reading a user's wallets when the
# sign-in token is minified (needs the "All - Read Only" scope). Secret.
DYNAMIC_API_TOKEN=
# Secret of the delegated-access webhook (dashboard, webhook detail page). Secret.
DYNAMIC_WEBHOOK_SECRET=
# Required with the credentials above. Path to the RSA private key PEM whose public key is registered
# for delegated access, e.g. openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out delegation.pem
DYNAMIC_DELEGATION_KEY_FILE=
# Secret of the Transaction Review webhook. Unset: every review request is answered with a denial.
DYNAMIC_REVIEW_SECRET=
# Optional. Path to the Ed25519 private key PEM that signs review answers, e.g.
# openssl genpkey -algorithm ED25519 -out review-signing.pem
DYNAMIC_REVIEW_SIGNING_KEY_FILE=

# Required. base64 of 32 random bytes that seal the delegated materials, e.g. openssl rand -base64 32
AGENT_STORAGE_KEY=

# Per-IP limit on /agent/v1/*: requests per window (ms). Integers, defaults 60000 and 120.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_API=
# Minimum time between two actions of one grant (ms). Integer, default 300000.
AGENT_COOLDOWN_MS=
# Highest gas limit the agent signs. Integer, default 3000000.
AGENT_MAX_GAS=
# Lifetime of a signing intent (ms). Integer, default 120000.
INTENT_TTL_MS=
# Longest grant lifetime (ms). Integer, default 2592000000 (30 days).
MAX_GRANT_MS=
# Wait for running actions at shutdown (ms). Integer, default 30000.
SHUTDOWN_GRACE_MS=
