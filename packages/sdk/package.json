{
  "name": "@selio/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Selio exit market: reads, quotes and unsigned transaction builders",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "2.57.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
